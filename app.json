{
  "expo": {
    "name": "SOL",
    "slug": "sol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.nulla.dex",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/brand/icon.png"
    },
    "splash": {
      "image": "./assets/brand/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-font",
      "./plugins/withCleartextHttp",
      [
        "expo-camera",
        {
          "cameraPermission": "允许 SOL 使用相机扫描二维码。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 SOL 选择包含二维码的图片用于扫码识别。"
        }
      ]
    ]
  }
}
